# DashScope (通义千问) API Key
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# WeChat Official Account (微信公众号)
# 获取地址：https://mp.weixin.qq.com → 开发 → 基本配置
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_DEFAULT_AUTHOR=JOTO
# 可选：不填时，推送草稿会按文章标题自动生成封面并上传到微信素材库。
WECHAT_DEFAULT_THUMB_MEDIA_ID=

# Email sending (Resend preferred; SMTP fallback)
RESEND_API_KEY=
RESEND_FROM=JOTO 内容工厂 <noreply@mail.jotoai.com>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
