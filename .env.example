# DashScope (通义千问) API Key
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# WeChat Official Account (微信公众号)
# 获取地址：https://mp.weixin.qq.com → 开发 → 基本配置
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_DEFAULT_AUTHOR=JOTO
# 可选：不填时，推送草稿会按文章标题自动生成封面并上传到微信素材库。
WECHAT_DEFAULT_THUMB_MEDIA_ID=

# Email sending (Resend preferred; SMTP fallback)
RESEND_API_KEY=
RESEND_FROM=JOTO 内容工厂 <noreply@mail.jotoai.com>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Persistent data directory.
# Local development can omit this; Docker sets it to /app/data/joto.
JOTO_DATA_DIR=
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL_GENERATE=deepseek-v4-pro

# Unsplash hotspot cover images
# 获取地址：https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# 可选：为产品配置更适合的英文图片搜索词。
# 示例：{"products":{"prod-fasium":["fashion atelier","garment studio"],"Lumen 营销云":["sales dashboard","crm workspace"]},"defaultQueries":["modern office"]}
UNSPLASH_TREND_IMAGE_QUERY_MAP=
